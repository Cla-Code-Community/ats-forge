# ats-forge — exemplo de variáveis de ambiente.
# Copie para `.env` (gitignored) e preencha. Nenhuma chave real deve ser commitada.
# Em Docker, estas variáveis vêm do docker-compose.yml do projeto candidate; este
# arquivo serve para rodar o serviço isolado (`npm run serve` / `npm start`).

# ---------------------------------------------------------------------------
# Serviço HTTP
# ---------------------------------------------------------------------------
PORT=8089
# Se definido, exige o header x-api-key nas rotas /resumes/*. Vazio = auth off.
ATS_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Camada de IA (multi-provider) — OPCIONAL
# ---------------------------------------------------------------------------
# Com AI_PROVIDER vazio ou "none", o motor roda 100% determinístico (sem IA).
# Para ligar, escolha o provedor e informe a chave correspondente.
#
# Privacidade: com a IA ligada, trechos do perfil e da descrição da vaga são
# enviados ao provedor para redação/análise. Envie apenas o necessário.

# Provedor ativo: "openai" | "gemini" | "none" (ou vazio).
AI_PROVIDER=none

# --- OpenAI (se AI_PROVIDER=openai) ---
OPENAI_API_KEY=
# Vazio usa o default gpt-4o-mini. Use um modelo que suporte Structured Outputs.
OPENAI_MODEL=gpt-4o-mini
# Opcional: endpoint compatível com a API da OpenAI (proxy/gateway). Vazio = oficial.
OPENAI_BASE_URL=

# --- Google Gemini (se AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Vazio usa o default gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# --- Ajustes gerais ---
# Fallback usado só em falha transitória do provedor principal e se tiver chave.
# Vazio = sem fallback. Ex.: AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
# Timeout por requisição (ms).
AI_TIMEOUT_MS=30000
# Tentativas extras em falhas transitórias (rate limit / timeout / indisponível).
AI_MAX_RETRIES=2
# Limite de caracteres de cada texto não confiável enviado ao provedor.
AI_MAX_INPUT_CHARS=12000
# Temperatura de geração (0..2).
AI_TEMPERATURE=0.3
