{
  "name": "ats-cv-generator",
  "version": "2.0.0",
  "description": "ATS resume-generation engine & microservice (DOCX + PDF + Markdown) — Clean Architecture, TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "ts-node src/main.ts",
    "generate:compiled": "node dist/main.js",
    "serve": "ts-node src/http.ts",
    "serve:compiled": "node dist/http.js",
    "start": "node dist/http.js",
    "setup": "cp resume.example.json resume.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "resume",
    "cv",
    "ats",
    "generator",
    "typescript",
    "clean-architecture"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "express": "^4.21.2",
    "pdfkit": "^0.15.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.39",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "rimraf": "^5.0.10",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
